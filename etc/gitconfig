[user]
	email = git@gottz.de
	name = Jan-Stefan Janetzky
	signingKey = ~/.ssh/id_ed25519
[submodule]
	recurse = true
#[url "git@github.com:"]
#	insteadOf = https://github.com/
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	forceSignAnnotated = true
	gpgsign = true
[gpg "ssh"]
	program = ssh-keygen
	allowedSignersFile = ~/.ssh/allowed_signers
[init]
	defaultBranch = root
[pull]
	rebase = true
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autoStash = true
[diff]
	algorithm = histogram
