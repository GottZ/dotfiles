export HISTSIZE=1000000
export SAVEHIST=1000000
setopt hist_ignore_all_dups
setopt hist_ignore_space

# this configuration is part of https://github.com/GottZ/dotfiles

# this config relies heavily on grml zsh.
# if you are on arch, simply run pacman -S grml-zsh-config
# otherwise: wget -O /etc/zsh/zshrc https://git.grml.org/f/grml-etc-core/etc/zsh/zshrc
# this config file will be automatically inherited by the grml zsh config.

# replacing all ls bases aliases with lsd
if check_com -c lsd; then
  for k v in ${(kv)aliases}; do
    if [[ "$v" = *"command ls "* ]]; then
      unalias "$k"
      alias "$k"="${v//command ls /command lsd }"
    fi
  done
fi

if check_com -c bat; then
  alias cat="bat --paging=never"
fi

if check_com -c yazi; then
  function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
fi

# ctrl + r history quality of life
if check_com -c fzf; then
  source <(fzf --zsh)
fi

# automagic nvm use . in directories with .nvmrc
if [[ -r "/usr/share/nvm/init-nvm.sh" ]]; then
  source "/usr/share/nvm/init-nvm.sh"
fi

# tmux should just use the current hostname as initial session name.
# this alias just makes it easy to spawn and reconnect to the initial session.
# who knows where this goes in future..
if check_com -c tmux; then
  if check_com -c hostnamectl; then
    HOSTNAME="$(hostnamectl hostname)"
  elif check_com -c hostname; then
    HOSTNAME="$(hostname)"
  else
    HOSTNAME="$(cat /etc/hostname)"
  fi
  if [[ -z "$HOSTNAME" ]]; then
    HOSTNAME="magic"
  fi
  alias tmx="tmux new -As ${HOSTNAME}"
fi

if check_com -c sudo; then
  alias root="sudo su -"
fi

if check_com -c docker; then
  alias dc="docker compose"
  alias dcu="docker compose up -d"
  alias dcd="docker compose down"
  alias dcr="docker compose restart"
  alias dcdu="docker compose down; docker compose up -d"
  alias dcl="docker compose logs -f -n200"
  alias dcdul="docker compose down; docker compose up -d && docker compose logs -f -n200"
  alias dcp="docker compose pull"
  alias dcpu="docker compose pull && docker compose up -d"
  alias dcpul="docker compose pull && docker compose up -d && docker compose logs -f -n200"
  alias dce="docker compose exec"
  alias dcb="docker compose build --pull"
  alias dcbn="docker compose build --pull --no-cache"
  alias dcbu="docker compose build --pull && docker compose up -d"
  alias dcbnu="docker compose build --pull --no-cache && docker compose up -d"
  function dcpua() {
    local images=() skipped=0 pulled=0 failed=0
    while read -r img; do
      [[ "$img" == *"<none>"* ]] && continue
      if [[ "$(docker image inspect --format '{{json .RepoDigests}}' "$img" 2>/dev/null)" == "[]" ]]; then
        skipped=$((skipped + 1))
        continue
      fi
      images+=("$img")
    done < <(docker images --format '{{.Repository}}:{{.Tag}}')

    echo "\033[1m:: pulling ${#images[@]} images (${skipped} local skipped)\033[0m"
    local i=0
    for img in "${images[@]}"; do
      i=$((i + 1))
      echo "\033[36m[${i}/${#images[@]}]\033[0m ${img}"
      if docker pull "$img" -q >/dev/null 2>&1; then
        pulled=$((pulled + 1))
      else
        failed=$((failed + 1))
        echo "\033[31m  failed: ${img}\033[0m"
      fi
    done

    echo "\033[1m:: pulled ${pulled}, failed ${failed}, skipped ${skipped}\033[0m"

    local -A project_services project_dirs
    while IFS=$'\t' read -r dir service; do
      [[ -z "$dir" || -z "$service" ]] && continue
      project_dirs[$dir]=1
      project_services[$dir]+="${service} "
    done < <(docker ps -q | xargs -r docker inspect --format='{{index .Config.Labels "com.docker.compose.project.working_dir"}}{{"\t"}}{{index .Config.Labels "com.docker.compose.service"}}')

    echo "\033[1m:: recreating running services in ${#project_dirs[@]} compose projects\033[0m"
    for dir in "${(@k)project_dirs}"; do
      local services=(${=project_services[$dir]})
      echo "\033[36m::\033[0m ${dir} (${services[*]})"
      docker compose --project-directory "$dir" up -d "${services[@]}"
    done
  }

  if ! check_com -c dive; then
    alias dive="docker run -ti --rm  -v /var/run/docker.sock:/var/run/docker.sock docker.io/wagoodman/dive"
  fi

  if ! check_com -c browsh; then
    alias browsh="docker run --rm -it --net=host browsh/browsh"
  fi
fi

if check_com -c gh; then
  alias gc="gh copilot"
  alias ge="gh copilot explain"
  alias gs="gh copilot suggest"
fi

# check if we are running in termux
#if [[ "$(which okc-ssh-agent)" == "/data/data/com.termux/files/usr/bin/okc-ssh-agent" ]]; then
if [[ "${HOME}" == "/data/data/com.termux/files/home" ]]; then
  FILEPREFIX="$HOME/.tmp/okc-ssh-agent"
  SOCK="$FILEPREFIX.sock"
  ENV="$FILEPREFIX.env"
  if ! pgrep okc-ssh-agent > /dev/null; then
    if [[ -r "$SOCK" ]]; then
      rm "$SOCK"
    fi
    okc-ssh-agent -a "$SOCK" | sed -e '/^echo /d' > "$ENV"
  fi
  source "$ENV"

  export PATH=$PATH:$HOME/go/bin
fi
