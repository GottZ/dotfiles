#!/usr/bin/env bash
# tmux-notify — Forward tmux bell events to a webhook
#
# Configuration (in order of precedence):
#   1. Command-line flags (--webhook-url, --debounce)
#   2. Environment variables (TMUX_NOTIFY_WEBHOOK_URL, TMUX_NOTIFY_DEBOUNCE)
#   3. Config file (~/.config/tmux-notify/config)
#
# Usage in tmux.conf:
#   if-shell 'command -v tmux-notify' {
#     set-option -g monitor-bell on
#     set-hook -g alert-bell 'run-shell -b "\
#       if [ \"#{pane_current_command}\" = \"claude\" ] && command -v tmux-notify >/dev/null 2>&1; then \
#         tmux-notify \
#           --session #{q:session_name} \
#           --window #{q:window_name} \
#           --pane #{q:pane_index} \
#           --path #{q:pane_current_path} \
#           --command #{q:pane_current_command} \
#           --active #{window_active} \
#           --clients #{session_attached} \
#           --host #{host} \
#           --window-index #{window_index} \
#           --pane-pid #{pane_pid} \
#           --pane-title #{q:pane_title} \
#           --window-panes #{window_panes} \
#           --window-activity #{window_activity} \
#           --pane-dead #{pane_dead} \
#           --session-id #{session_id} \
#           --session-windows #{session_windows} ; \
#       fi \
#     "'
#   }

set -uo pipefail

# --- Defaults ---
WEBHOOK_URL=""
DEBOUNCE_SECONDS=5
SESSION=""
WINDOW=""
PANE=""
PATH_DIR=""
COMMAND=""
ACTIVE=""
CLIENTS=""
HOST=""
WINDOW_INDEX=""
PANE_PID=""
PANE_TITLE=""
WINDOW_PANES=""
WINDOW_ACTIVITY=""
PANE_DEAD=""
SESSION_ID=""
SESSION_WINDOWS=""

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-notify"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-notify/config"

# --- Config file ---
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
  # Config uses same variable names: WEBHOOK_URL, DEBOUNCE_SECONDS
fi

# --- Environment overrides ---
WEBHOOK_URL="${TMUX_NOTIFY_WEBHOOK_URL:-$WEBHOOK_URL}"
DEBOUNCE_SECONDS="${TMUX_NOTIFY_DEBOUNCE:-$DEBOUNCE_SECONDS}"

# --- Parse arguments ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    --webhook-url)  WEBHOOK_URL="$2";      shift 2 ;;
    --debounce)     DEBOUNCE_SECONDS="$2";  shift 2 ;;
    --session)      SESSION="$2";           shift 2 ;;
    --window)       WINDOW="$2";            shift 2 ;;
    --pane)         PANE="$2";              shift 2 ;;
    --path)         PATH_DIR="$2";          shift 2 ;;
    --command)      COMMAND="$2";           shift 2 ;;
    --active)       ACTIVE="$2";            shift 2 ;;
    --clients)      CLIENTS="$2";           shift 2 ;;
    --host)         HOST="$2";              shift 2 ;;
    --window-index) WINDOW_INDEX="$2";      shift 2 ;;
    --pane-pid)     PANE_PID="$2";          shift 2 ;;
    --pane-title)   PANE_TITLE="$2";        shift 2 ;;
    --window-panes) WINDOW_PANES="$2";      shift 2 ;;
    --window-activity) WINDOW_ACTIVITY="$2"; shift 2 ;;
    --pane-dead)    PANE_DEAD="$2";         shift 2 ;;
    --session-id)   SESSION_ID="$2";        shift 2 ;;
    --session-windows) SESSION_WINDOWS="$2"; shift 2 ;;
    --help|-h)
      echo "Usage: tmux-notify --session <s> --window <w> --pane <p> --path <dir> --command <cmd>"
      echo ""
      echo "Options:"
      echo "  --webhook-url <url>   Webhook endpoint (or set TMUX_NOTIFY_WEBHOOK_URL)"
      echo "  --debounce <seconds>  Suppress duplicate bells within N seconds (default: 5)"
      echo "  --session <name>      tmux session name"
      echo "  --window <name>       tmux window name"
      echo "  --pane <index>        tmux pane index"
      echo "  --path <dir>          Working directory of the pane"
      echo "  --command <cmd>       Current command running in the pane"
      echo "  --active <0|1>        Whether the bell window is currently active"
      echo "  --clients <n>         Number of clients attached to the session"
      echo "  --host <name>         Hostname of the tmux server"
      echo "  --window-index <n>    Window index number"
      echo "  --pane-pid <pid>      PID of the pane process"
      echo "  --pane-title <title>  Pane title"
      echo "  --window-panes <n>    Number of panes in the window"
      echo "  --window-activity <t> Timestamp of last window activity"
      echo "  --pane-dead <0|1>     Whether the pane process has exited"
      echo "  --session-id <id>     Unique session ID"
      echo "  --session-windows <n> Number of windows in the session"
      echo ""
      echo "Config file: \$XDG_CONFIG_HOME/tmux-notify/config"
      exit 0
      ;;
    *)
      echo "tmux-notify: unknown option '$1'" >&2
      exit 1
      ;;
  esac
done

# --- Validate ---
if [[ -z "$WEBHOOK_URL" ]]; then
  echo "tmux-notify: no webhook URL configured" >&2
  echo "  Set TMUX_NOTIFY_WEBHOOK_URL, --webhook-url, or add WEBHOOK_URL to $CONFIG_FILE" >&2
  exit 1
fi

# --- Debounce ---
# Hash all parameters to detect identical events
debounce_key=$(printf '%s\0%s\0%s\0%s\0%s' "$SESSION" "$WINDOW" "$PANE" "$PATH_DIR" "$COMMAND" | md5sum | cut -d' ' -f1)
debounce_file="$CACHE_DIR/$debounce_key"

mkdir -p "$CACHE_DIR"

if [[ -f "$debounce_file" ]]; then
  last_ts=$(cat "$debounce_file")
  now=$(date +%s)
  elapsed=$(( now - last_ts ))
  if (( elapsed < DEBOUNCE_SECONDS )); then
    exit 0
  fi
fi

date +%s > "$debounce_file"

# --- Cleanup stale debounce files (older than 1 hour, non-blocking) ---
find "$CACHE_DIR" -maxdepth 1 -type f -mmin +60 -delete 2>/dev/null &

# --- Build JSON payload ---
json_string() { printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g' | sed ':a;N;$!ba;s/\n/\\n/g'; }
json_number() { [[ "$1" =~ ^[0-9]+$ ]] && printf '%s' "$1" || printf '0'; }

PAYLOAD=$(cat <<ENDJSON
{
  "session": "$(json_string "$SESSION")",
  "window": "$(json_string "$WINDOW")",
  "pane": $(json_number "$PANE"),
  "path": "$(json_string "$PATH_DIR")",
  "command": "$(json_string "$COMMAND")",
  "active": $(json_number "$ACTIVE"),
  "clients": $(json_number "$CLIENTS"),
  "host": "$(json_string "$HOST")",
  "window_index": $(json_number "$WINDOW_INDEX"),
  "pane_pid": $(json_number "$PANE_PID"),
  "pane_title": "$(json_string "$PANE_TITLE")",
  "window_panes": $(json_number "$WINDOW_PANES"),
  "window_activity": $(json_number "$WINDOW_ACTIVITY"),
  "pane_dead": $(json_number "$PANE_DEAD"),
  "session_id": "$(json_string "$SESSION_ID")",
  "session_windows": $(json_number "$SESSION_WINDOWS")
}
ENDJSON
)

# --- Send webhook ---
curl -sf --max-time 10 \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" \
  "$WEBHOOK_URL" >/dev/null 2>&1 || true

